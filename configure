#!/bin/sh

# Store models cpp source code as a reference at runtime.
for f in src/model_*.cpp; do
  [ -f "$f" ] || continue
  name=`basename "$f" .cpp | sed 's/^model_//'`
  dir="inst/models/${name}"
  [ -d "$dir" ] || continue
  cp "$f" "${dir}/model.cpp"
done

# Resolve RcppParallel link flags at install time.
RCPPPARALLEL_LIBS=`"${R_HOME}/bin/Rscript" -e "RcppParallel::RcppParallelLibs()"`
sed -e "s|@RCPPPARALLEL_LIBS@|${RCPPPARALLEL_LIBS}|" \
    src/Makevars.in > src/Makevars
