#!/bin/sh

# Source of truth for template models lives in src/model_<name>.cpp.
# Mirror them into inst/models/<name>/model.cpp so the template machinery
# (system.file("models", ...)) can find them at runtime.
for f in src/model_*.cpp; do
  [ -f "$f" ] || continue
  name=`basename "$f" .cpp | sed 's/^model_//'`
  dir="inst/models/${name}"
  [ -d "$dir" ] || continue
  cp "$f" "${dir}/model.cpp"
done
