#!/bin/sh

# store models cpp source code as a reference at runtime
# NOTE: enforce ending with LF even on Windows.
for f in src/model_*.cpp; do
  [ -f "$f" ] || continue
  name=`basename "$f" .cpp | sed 's/^model_//'`
  dir="inst/models/${name}"
  [ -d "$dir" ] || continue
  tr -d '\r' < "$f" > "${dir}/model.cpp"
done

# resolve RcppParallel link flags at install time
RCPPPARALLEL_LIBS=`"${R_HOME}/bin/Rscript.exe" -e "RcppParallel::RcppParallelLibs()"`
cat > src/Makevars.win << EOF
CXX_STD = CXX17
PKG_CXXFLAGS = -I"../inst/include"
PKG_LIBS = ${RCPPPARALLEL_LIBS}
EOF
