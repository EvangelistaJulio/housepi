    "def visualizer(results, num_adapt_iter = 5000, burn_in = 5000, target = {}) :\n",
    "    \n",
    "    df = results[results.index > num_adapt_iter+burn_in]\n",
    "    cols = df.columns.to_list()\n",
    "    cols.remove('loglike')\n",
    "    param_names = [c for c in cols if \"__a%\" not in c]\n",
    "\n",
    "    thinning = df.index[1] - df.index[0]\n",
    "    iterations = thinning * np.arange(len(df))\n",
    "\n",
    "    fig, axes = plt.subplots(figsize=(11, 3), ncols=2, )\n",
    "    fig.subplots_adjust(wspace=0.25)\n",
    "    \n",
    "    mu, sigma = mcmc_mean(df[\"loglike\"])\n",
    "    axes[0].axhline(y=mu, color=\"black\", lw=2, ls=\"-\")\n",
    "    axes[0].axhline(y=mu-sigma, color=\"black\", lw=2, ls=\"--\")\n",
    "    axes[0].axhline(y=mu+sigma, color=\"black\", lw=2, ls=\"--\")\n",
    "\n",
    "    axes[0].plot(df.index, df[\"loglike\"], color = \"red\", lw=0.5)\n",
    "\n",
    "    axes[0].set_xlabel(\"N. of iterations\")\n",
    "    axes[0].set_ylabel(\"Loglikelihood\")\n",
    "\n",
    "    autocorr = autocorrelation( df[\"loglike\"])\n",
    "    period = np.round(find_period(autocorr)).astype(int)\n",
    "\n",
    "    axes[1].plot(iterations[:len(autocorr)], autocorr)\n",
    "    axes[1].axhline(y=0, color=\"grey\", ls = \"--\")\n",
    "    axes[1].axvline(x=thinning * period, color=\"red\", ls=\"--\")\n",
    "\n",
    "\n",
    "    n_rows = max(2, len(param_names))\n",
    "    fig, axes = plt.subplots(figsize=(11, 3 * n_rows),\n",
    "                            nrows=n_rows, ncols=2, sharex=False)\n",
    "    fig.subplots_adjust(wspace=0.25)\n",
    "\n",
    "    inferred_parameters = {}\n",
    "\n",
    "    for i, p in enumerate(param_names) :\n",
    "        mu, sigma = mcmc_mean(df[p])\n",
    "        axes[i, 0].axhline(y=mu, color=\"black\", lw=2, ls=\"-\")\n",
    "        axes[i, 0].axhline(y=mu-sigma, color=\"black\", lw=2, ls=\"--\")\n",
    "        axes[i, 0].axhline(y=mu+sigma, color=\"black\", lw=2, ls=\"--\")\n",
    "\n",
    "        axes[i, 0].plot(df.index, df[p], label=p, lw=0.5)\n",
    "        axes[i, 0].set_ylabel(p)\n",
    "\n",
    "        if p in target :\n",
    "            axes[i, 0].axhline(y=target[p], color=\"red\", lw=2, ls=\"--\")\n",
    "\n",
    "\n",
    "        axes[i, 1].plot(df.index, df[f\"{p}__a%\"], label=p, lw=1, color=\"grey\")\n",
    "        axes[i, 1].set_ylabel(f\"{p}__a%\")\n",
    "        #axes[i, 0].set_yscale(\"log\")\n",
    "        #xes[i, 1].set_xscale(\"log\")\n",
    "        axes[i, 1].set_ylim([0, 50])\n",
    "        axes[i, 1].axhline(y=25, ls=\"--\", lw=1, color='black')\n",
    "\n",
    "        inferred_parameters[p] = [mu, sigma]\n",
    "\n",
    "    axes[0, 0].set_title(\"Parameter\")\n",
    "    axes[0, 1].set_title(\"Acceptation Rate\")\n",
    "    axes[-1, 0].set_xlabel(\"N. of iterations\")\n",
    "    axes[-1, 1].set_xlabel(\"N. of iterations\")\n",
    "\n",
    "    return inferred_parameters"
   ]
