    "from scipy.optimize import root_scalar\n",
    "from scipy.interpolate import interp1d\n",
    "\n",
    "# autocorrelation function\n",
    "# FIXME\n",
    "def autocorrelation(signal):\n",
    "    x = np.array(signal) \n",
    "\n",
    "    # Normalized data\n",
    "    ndata = x - np.mean(x)\n",
    "    N = len(ndata)\n",
    "\n",
    "    # Variance\n",
    "    var = np.var(x)\n",
    "\n",
    "    acorr = np.correlate(ndata, ndata, 'full')[N-1:N+N//2] \n",
    "    return acorr / (N * var)\n",
    "\n",
    "# root finder\n",
    "def find_period(autocorr, tol=1e-6, max_iter=1000):\n",
    "\n",
    "    interp_func = interp1d(np.arange(len(autocorr)), autocorr, kind='linear')\n",
    "    end = np.where(autocorr < 0)[0][0]\n",
    "\n",
    "    if interp_func(0) * interp_func(end) >= 0:\n",
    "        raise ValueError(\"The function values at the interval endpoints must have opposite signs.\")\n",
    "\n",
    "    result = root_scalar(interp_func, bracket=[0, end], method='bisect', xtol=tol)\n",
    "\n",
    "    if result.converged:\n",
    "        return result.root\n",
    "    else:\n",
    "        raise Exception(\"Root finding did not converge.\")\n",
    "    \n",
    "# compute mean and standard deviation from uncorrelated samples\n",
    "def mcmc_mean(data) :\n",
    "    autocorr = autocorrelation(data)\n",
    "    period = np.round(find_period(autocorr)).astype(int)\n",
    "\n",
    "    return [data[::-period].mean(), data[::-period].std(ddof=1)]"
