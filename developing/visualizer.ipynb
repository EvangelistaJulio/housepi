    "file_name = \"../data/parameters.txt\"\n",
    "params = pd.read_csv(file_name, sep=\" \", header=None, index_col=0)\n",
    "target = { p : params.at[p, 1] for p in params.index}\n",
    "\n",
    "file_name = \"../output/validate.txt\"\n",
    "results = pd.read_csv(file_name, sep=\" \", index_col=\"iter\")\n",
    "inferred_parameters = visualizer(results,  num_adapt_iter = 5000, burn_in = 5000, target=target)\n",
    "\n",
    "for k in inferred_parameters.keys():\n",
    "    print(k, np.round(inferred_parameters[k], 5))"
