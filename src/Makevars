CXX_STD = CXX17
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -D_HOUSEPI_RCPP -I../inst/template/include
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS)

MODELS_PATH = ../inst/models
define model_template
MODEL_$(1)_FLDR = $(MODELS_PATH)/$(2)
MODEL_$(1)_DLL = $$(MODEL_$(1)_FLDR)/$$(subst _,,$(2))$$(SHLIB_EXT)
endef
$(eval $(call model_template,0,blank))
$(eval $(call model_template,1,augmented_example))
$(eval $(call model_template,2,augmented_infection_time))
$(eval $(call model_template,3,chain_binomial))
$(eval $(call model_template,4,chain_binomial_heterogeneous))

all: $(SHLIB) $(MODEL_0_DLL) $(MODEL_1_DLL) $(MODEL_2_DLL) $(MODEL_3_DLL) $(MODEL_4_DLL)

$(MODELS_PATH)/%/model.o: $(MODELS_PATH)/%/model.cpp $(SHLIB)
	@echo "*** building template: '$*'"
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -I$(MODELS_PATH)/$* -D_HOUSEPI_MODULE_NAME=$(subst _,,$*) -c $< -o $@

define link_template
$$(MODEL_$(1)_DLL): $$(MODEL_$(1)_FLDR)/model.o $$(SHLIB)
	$$(SHLIB_LINK) -o $$(MODEL_$(1)_DLL) $$^ $$(ALL_LIBS)
endef
$(eval $(call link_template,0))
$(eval $(call link_template,1))
$(eval $(call link_template,2))
$(eval $(call link_template,3))
$(eval $(call link_template,4))

.PHONY: all
