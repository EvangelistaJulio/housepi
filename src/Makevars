CXX_STD = CXX17

PKG_CXXFLAGS = \
  $(SHLIB_OPENMP_CXXFLAGS) \
  -D_HOUSEPI_RCPP \
  -I../inst/template/include

PKG_LIBS = \
  $(SHLIB_OPENMP_CXXFLAGS)

COMMON_SOURCES = \
	RcppExports.cpp \
	attribute.cpp \
	augmented.cpp \
	binomial.cpp \
	contact_rate.cpp \
	data_long.cpp \
	data_wide.cpp \
	distribution.cpp \
	export_bindings.cpp \
	export_wrappers.cpp \
	flags.cpp \
	function.cpp \
	group_rate.cpp \
	infec_profile.cpp \
	mcmc.cpp \
	mcmc_impl.cpp \
	parameter.cpp \
	setup.cpp \
	tools.cpp \
	variable.cpp 

COMMON_OBJECTS = $(COMMON_SOURCES:.cpp=.o)

MODEL1_NAME = augmented_example
MODEL1_DLL = ../inst/models/$(MODEL1_NAME)/housepi$(subst _,,$(MODEL1_NAME))$(SHLIB_EXT)

MODEL2_NAME = augmented_infection_time
MODEL2_DLL = ../inst/models/$(MODEL2_NAME)/housepi$(subst _,,$(MODEL2_NAME))$(SHLIB_EXT)

MODEL3_NAME = chain_binomial
MODEL3_DLL = ../inst/models/$(MODEL3_NAME)/housepi$(subst _,,$(MODEL3_NAME))$(SHLIB_EXT)

MODEL4_NAME = chain_binomial_heterogeneous
MODEL4_DLL = ../inst/models/$(MODEL4_NAME)/housepi$(subst _,,$(MODEL4_NAME))$(SHLIB_EXT)

all: $(SHLIB) cache_template $(MODEL1_DLL) $(MODEL2_DLL) $(MODEL3_DLL) $(MODEL4_DLL)

cache_template: $(SHLIB)
	@echo "** caching templates"
	@mkdir -p ../inst/template/src
	@cp $(COMMON_SOURCES) model.cpp $(COMMON_OBJECTS) ../inst/template/src/
	@cp $(SHLIB) ../inst/template/src/housepienvironment$(SHLIB_EXT)
	
../inst/models/%/model.o: ../inst/models/%/model.cpp
	@echo "*** building template: '$*'"
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -I../inst/models/$* -c $< -o $@
	
$(MODEL1_DLL): ../inst/models/$(MODEL1_NAME)/model.o $(COMMON_OBJECTS)
	$(SHLIB_LINK) -o $(MODEL1_DLL) $^ $(ALL_LIBS)
	@$(RM) ../inst/models/$(MODEL1_NAME)/model.o

$(MODEL2_DLL): ../inst/models/$(MODEL2_NAME)/model.o $(COMMON_OBJECTS)
	$(SHLIB_LINK) -o $(MODEL2_DLL) $^ $(ALL_LIBS)
	@$(RM) ../inst/models/$(MODEL2_NAME)/model.o

$(MODEL3_DLL): ../inst/models/$(MODEL3_NAME)/model.o $(COMMON_OBJECTS)
	$(SHLIB_LINK) -o $(MODEL3_DLL) $^ $(ALL_LIBS)
	@$(RM) ../inst/models/$(MODEL3_NAME)/model.o

$(MODEL4_DLL): ../inst/models/$(MODEL4_NAME)/model.o $(COMMON_OBJECTS)
	$(SHLIB_LINK) -o $(MODEL4_DLL) $^ $(ALL_LIBS)
	@$(RM) ../inst/models/$(MODEL4_NAME)/model.o

.PHONY: all cache_template
