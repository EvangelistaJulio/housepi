(default is most represented group).
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{HousepiModel$add_group_rate(
  name,
  by,
  prefix = NA,
  reference = NULL,
  independent = TRUE,
  prior = "lnorm",
  args = list(meanlog = 0, sdlog = 3),
  min = NA,
