\subsection{Method \code{add_group_rate()}}{
Add definitions of a group rate by given data feature(s).
Group rates are relative to a reference class that can be specified.
If no MCMC options are provided, the following configuration is assumed
\itemize{
\item \code{prior}: "lognormal"
\item \code{args}: \code{c(meanlog = 0, sdlog = 3)}
\item \code{min}: 0
\item \code{max} 10
}
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{HousepiModel$add_group_rate(
  name,
  by,
  prefix = NA_character_,
  reference = NULL,
  independent = TRUE,
  prior = NA_character_,
  args = NULL,
  min = NULL,
  max = NULL,
  rule = NA_character_,
  scale = NA_real_
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{name}}{\code{character(1)} name used by internal calls.}

\item{\code{by}}{\code{list} with feature(s) associated to group rate as data headers.\cr
Corresponding data columns have to be categorical.}

\item{\code{prefix}}{\code{character(1)} with prefix to parameter names associated to the group rate.\cr
If \code{NA} uses the first 3 letters of rate name (default).}

\item{\code{reference}}{named \code{list} to choose reference group providing corresponding features.\cr
