\subsection{Method \code{add_group_rate()}}{
Add definitions of a group rate by given data covariate(s).
Rates are relative to a reference class that can be specified.
If no MCMC options are provided, the prior is assumed to be
\eqn{\mathrm{lognormal}[\mu=0, \sigma=3]} with support \eqn{[0, 10]}.
Bypass automatic generation by providing a custom pre-built logic table.
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{HousepiModel$add_group_rate(
  name,
  by = NA_character_,
  prefix = NA_character_,
  reference = NULL,
  joint = FALSE,
  strata = NULL,
  params = NULL,
  prior = NA_character_,
  ...,
  min = NA_real_,
  max = NA_real_,
  proposal = NA_character_,
  proposal_scale = NA_real_
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{name}}{\code{character(1)} Name used by internal calls.}

\item{\code{by}}{\code{list} Covariates associated to group rate as data headers.
Corresponding data columns have to be categorical.}

\item{\code{prefix}}{\code{character(1)} Prefix to names of associated parameters. If \code{NA} uses the first 3 letters of rate name (default).}

\item{\code{reference}}{named \code{list} Covariates associated to reference group.
Pass \code{".none"} to disable reference, giving every rate its own parameter.
Default reference group is the one with the largest sample size.}

\item{\code{joint}}{\code{logical(1)} Treat covariates as joint.
If \code{FALSE}, covariates are independent (default).}

\item{\code{strata}}{\code{data.frame} Individual covariates and relative \code{param_name}.
Each row defines one stratum. If \code{NA}, then match any value.
Use \code{.reference} in \code{param_name} to designate the reference group.
Mutually exclusive with \code{by}.}

\item{\code{params}}{named \code{list} Per-parameter MCMC setups as in \code{param_name}.
Overrides shared prior/args for parameters specificied in the list.
Ignored if automatic definition.}

\item{\code{prior}}{\code{character(1)} Choice for the prior distribution.}

\item{\code{...}}{named arguments for the prior distribution.}

\item{\code{min}}{\code{numeric(1)} Truncate to a minimum value.}

\item{\code{max}}{\code{numeric(1)} Truncate to a maximum value.}

\item{\code{proposal}}{\code{character(1)} Proposal used in the Monte Carlo.
One between:
\describe{
\item{\code{"uniform"}}{increments drawn from uniform;}
\item{\code{"normal"}}{increments drawn from normal;}
\item{\code{"lognormal"}}{log-increments drawn from lognormal (positive values only);}
\item{\code{"sample"}}{sampled from the \%s distribution;}
\item{\code{NA}}{same as \code{"sample"} (default).}
}}

\item{\code{proposal_scale}}{\code{numeric(1)} Scale of the proposal.
If \code{NA}, scale is adapted during inference when \code{adapt > 0} (default).
If a positive numeric, scale is fixed to that value and never adapted.
Ignored when proposal is \code{"sample"}.}
}
\if{html}{\out{</div>}}
}
}
